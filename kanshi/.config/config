profile docked {

    output DP-2 mode 3840x2160 scale 1.333333 enable position 0,0   
    output eDP-1 disable
}

profile extend {
    output DP-2 mode 3840x2160 scale 1.333333 enable position 0,0   
    output eDP-1 mode 2520x1680 scale 1.5 enable position 600,1620
}

profile main {
    output DP-2 disable
    output eDP-1 mode 2520x1680 scale 1.5 enable position 0,0   
}

profile in-move {
    output eDP-1 mode 2520x1680 scale 1.5 enable position 0,0   
}
