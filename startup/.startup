#!/bin/bash

# Mute microphone at startup(privacy measure)
amixer -q sset Capture nocap 100% &

#Set screen lock timeout
# xautolock -time 5 -locker slock &

#Turn off screen saver and disable DPMS
#xset s off -dpms &

# This script sends notification when battery reaches predefined threshold(e.g. 10%)
$HOME/.scripts/battery_warning.sh &

# Reserved for huawei matebook 14s and its sloppy audio driver
#amixer -q sset Speaker unmute &
#amixer -q sset Headphone unmute &

# Start some useful programs
dwmblocks &
picom --log-file=~/.picom.log&
polkit-dumb-agent &
udiskie -ans &
dunst &
xbindkeys &
solaar -w hide &
wmname "LG3D" &
#nm-applet &
blueman-applet &
blueman-applet &

# Automatically arrange screens and set backgroud
sleep 1
#ascarrange &
