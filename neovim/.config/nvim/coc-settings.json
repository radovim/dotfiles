{
    "languageserver": {
        "ccls": {
            "command": "ccls",
            "filetypes": ["c", "cc", "cpp", "c++", "objc", "objcpp"],
            "rootPatterns": [".ccls", "compile_commands.json", ".git/", ".hg/"],
            "initializationOptions": {
                "cache": {
                    "directory": "/tmp/ccls"
                }
            }
        },
        "robotframework_ls": {
            "command": "robotframework_ls",
            "filetypes": ["robot"],
            "settings": {
                // here the ls configuration
            }

        }
    }
}

