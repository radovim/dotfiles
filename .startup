#!/bin/bash

$HOME/.scripts/set_displays.sh &
amixer -q sset Capture nocap 100% &
feh --bg-scale $HOME/Pictures/Wallpapers/0293.jpg
#feh --bg-scale $HOME/Pictures/Wallpapers/2080886.jpg
#feh --bg-scale $HOME/Pictures/Wallpapers/0005.jpg &

#Set screen lock timeout
# xautolock -time 5 -locker slock &

#Turn off screen saver and disable DPMS
xset s off -dpms &

#barriers -c ~/.barrier/server.conf --disable-crypto &

$HOME/.scripts/battery_warning.sh &
amixer -c 0 sset Headphone unmute &
dwmblocks &
#thunderbird &
mailspring &
picom --experimental-backends &
polkit-dumb-agent &
udiskie &
dunst &
xbindkeys &
solaar -w hide &
wmname "LG3D" &
nm-applet &
blueman-applet &
syncthing --no-browser
#teams-for-linux &
teams &
