#!/bin/bash

/home/$USER/software/linux_scripts/set_displays.sh &
amixer -q sset Capture nocap 100% &
feh --bg-scale /home/$USER/Pictures/Wallpapers/1586853730_nord-peeks.png &

#$(sleep 4s && "$HOME/.config/polybar/launch.sh") &

#Set screen lock timeout
xautolock -time 5 -locker slock &

#Turn off screen saver and disable DPMS
xset s off -dpms &

#barriers -c ~/.barrier/server.conf --disable-crypto & 

mailspring &
picom --experimental-backends &
nextcloud --background &
udiskie &
bluetoothctl scan on &
blueman-applet &
dunst &
teams &
